{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfluxo.io/contracts/domain-events/payloads/payments.settlement_completed.v1.schema.json",
  "title": "payments.settlement_completed.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "settlement_id",
    "payment_process_id",
    "provider_reference",
    "rail",
    "money",
    "settled_at",
    "reconciliation_status"
  ],
  "properties": {
    "settlement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payment_process_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "rail": {
      "type": "string",
      "enum": ["mpesa", "emola", "mkesh", "bank_transfer"]
    },
    "money": {
      "$ref": "#/$defs/money"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "reconciliation_status": {
      "type": "string",
      "const": "MATCHED"
    }
  },
  "$defs": {
    "positive_decimal": {
      "type": "string",
      "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.0*[1-9][0-9]*)$"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "$ref": "#/$defs/positive_decimal"
        },
        "currency": {
          "type": "string",
          "const": "MZN"
        }
      }
    }
  }
}
