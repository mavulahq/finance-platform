{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfluxo.io/contracts/domain-events/payloads/ledger.journal_posted.v1.schema.json",
  "title": "ledger.journal_posted.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["journal_entry_id", "transaction_id", "posted_at", "line_count", "totals", "lines"],
  "properties": {
    "journal_entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "posted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "line_count": {
      "type": "integer",
      "minimum": 2
    },
    "totals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/currency_total"
      }
    },
    "lines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/ledger_line"
      }
    }
  },
  "$defs": {
    "non_negative_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "currency_total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "debit", "credit"],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "debit": {
          "$ref": "#/$defs/non_negative_decimal"
        },
        "credit": {
          "$ref": "#/$defs/non_negative_decimal"
        }
      }
    },
    "ledger_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_code", "currency", "debit", "credit"],
      "properties": {
        "account_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "debit": {
          "$ref": "#/$defs/non_negative_decimal"
        },
        "credit": {
          "$ref": "#/$defs/non_negative_decimal"
        }
      }
    }
  }
}
