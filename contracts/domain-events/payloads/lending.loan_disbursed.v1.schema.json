{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfluxo.io/contracts/domain-events/payloads/lending.loan_disbursed.v1.schema.json",
  "title": "lending.loan_disbursed.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_id", "destination_account_id", "money"],
  "properties": {
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "destination_account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "money": {
      "$ref": "#/$defs/money"
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.0*[1-9][0-9]*)$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
