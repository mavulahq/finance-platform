{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfluxo.io/contracts/domain-events/event-catalog.schema.json",
  "title": "Fluxo Domain Event Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalog_entry"
      }
    }
  },
  "$defs": {
    "catalog_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "event_version",
        "owner_context",
        "producer",
        "aggregate_type",
        "status",
        "data_classification",
        "description",
        "ordering_key",
        "consumers"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "maxLength": 120
        },
        "event_version": {
          "type": "integer",
          "minimum": 1
        },
        "owner_context": {
          "type": "string",
          "enum": [
            "tenant_identity",
            "product_configuration",
            "accounts_ledger",
            "lending",
            "payments",
            "workflow_configuration",
            "automation_execution",
            "audit_reporting"
          ]
        },
        "producer": {
          "type": "string",
          "enum": ["fengine", "fwk", "fpay"]
        },
        "aggregate_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "active", "deprecated"]
        },
        "data_classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ordering_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["fengine", "fwk", "fpay", "fwallet", "fdocs", "fxAI"]
          }
        },
        "payload_schema": {
          "type": "string",
          "format": "uri-reference"
        },
        "deprecation_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
