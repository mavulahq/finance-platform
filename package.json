{
  "name": "getfluxo",
  "version": "1.0.0",
  "private": true,
  "description": "Fluxo by getfluxo.io - configurable Banking as a Service (BaaS) infrastructure",
  "author": "EstandarMustaq <mustaqueestandarjunior@gmail.com>",
  "copyright": "Copyright (c) 2025-2026 getfluxo.io - All Rights Reserved",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://getfluxo.io",
  "repository": {
    "type": "git",
    "url": "git@github.com:getfluxo-io/getfluxo.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.22.3",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "submodules:init": "git submodule sync --recursive && git submodule update --init --recursive",
    "git:hooks:install": "bash scripts/setup-git-hooks.sh",
    "pr:merge": "node scripts/merge-pr.mjs",
    "test:guardrails": "node --test scripts/guardrails.test.mjs",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "contracts:check": "node scripts/validate-domain-contracts.mjs && node --test scripts/validate-domain-contracts.test.mjs",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "ci:submodule:sync": "git submodule sync --recursive && git submodule update --init --recursive",
    "dev:services:up": "docker compose up -d postgres redis",
    "dev:services:down": "docker compose down",
    "dev:services:logs": "docker compose logs -f postgres redis",
    "dev:services:ps": "docker compose ps",
    "docs:generate": "pnpm --filter @getfluxo/fdocs generate",
    "infra:plan": "pnpm --filter @getfluxo/finfra tf:plan",
    "infra:apply": "pnpm --filter @getfluxo/finfra tf:apply",
    "docker:build-all": "pnpm --filter @getfluxo/finfra docker:build",
    "deploy:staging": "pnpm --filter @getfluxo/finfra deploy:staging",
    "deploy:production": "pnpm --filter @getfluxo/finfra deploy:prod"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "workspaces": [
    "packages/fengine",
    "packages/fwallet",
    "packages/fwallet-mobile",
    "packages/fwk",
    "packages/fxAI",
    "packages/fpay",
    "packages/finfra",
    "packages/fdocs"
  ]
}
